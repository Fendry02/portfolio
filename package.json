{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --check --ignore-path .gitignore .",
    "format:fix": "prettier --write --ignore-path .gitignore .",
    "security:audit": "npm audit --audit-level=low",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:serp": "node --env-file-if-exists=.env.local scripts/serp-monitor.mjs",
    "seo:gsc:auth": "node --env-file-if-exists=.env.local scripts/search-console-auth.mjs",
    "seo:gsc:report": "node --env-file-if-exists=.env.local scripts/search-console-report.mjs",
    "test": "node --test \"app/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "convert-images": "node scripts/convert-images.js",
    "generate-responsive": "node scripts/generate-responsive-images.js",
    "build:card": "node business-card/build-pdf.js"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.12",
    "@next/third-parties": "^16.2.12",
    "@phosphor-icons/react": "^2.1.10",
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-frontmatter": "^5.0.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.12",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "cssnano": "^8.0.2",
    "daisyui": "^5.5.23",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.25",
    "prettier": "^3.8.4",
    "puppeteer": "^25.1.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
