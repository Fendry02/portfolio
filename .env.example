# SemScraper API key (local only — never commit a real key)
SEMSCRAPER_API_KEY=

# The initial local-market baseline uses 4 offers × desktop and mobile = 8 SERPs.
SEMSCRAPER_GEOLOCATION=Lyon, France
SEMSCRAPER_DEVICES=desktop,mobile
SEMSCRAPER_DEPTH=1

# Google Search Console (local OAuth client and read-only token)
# Create a Google Cloud OAuth desktop client; see README.md before setting these.
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:bbenoit.fr
GOOGLE_SEARCH_CONSOLE_REDIRECT_PORT=42813
